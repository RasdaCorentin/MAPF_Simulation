@startuml sequence_tick

title One simulation tick — Simulation.step() call chain

skinparam SequenceMessageAlign center
skinparam ParticipantBorderColor #4A90D9
skinparam ParticipantBackgroundColor #EAF4FF
skinparam ArrowColor #333333
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #C9B458

actor Caller
participant Simulation
participant "fleet : FleetManager\n<<Dispatcher>>" as Fleet
participant TaskSource
participant Allocator
participant "coordinator\n<<Coordinator>>" as Coord
participant Grid
participant Agent

Caller -> Simulation : step()
activate Simulation

Simulation -> Simulation : current_step += 1

== 1. Spawn deferred entities ==
loop each pending entity whose appear_at is reached
    Simulation -> Grid : place(entity)
end

== 2. Dispatch tasks (only if a dispatcher is attached) ==
Simulation -> Fleet : dispatch(agents, grid, current_step)
activate Fleet
    Fleet -> Fleet : _complete(agents)
    note right of Fleet
      ASSIGNED task whose assignee
      reached its target -> DONE
    end note
    Fleet -> Fleet : _watchdog(step)
    note right of Fleet
      An assignee that has not improved its Manhattan
      distance to the target for `patience` steps is
      released and the task retried; past `max_attempts`
      assignees the task is FAILED. This is what stops an
      unreachable target from holding a robot hostage.
    end note

    Fleet -> Fleet : _prune()
    note right of Fleet
      DONE / FAILED tasks leave the list, but are counted
      on the way out — dropping them silently would hide
      the deadlock the watchdog exists to close.
    end note

    Fleet -> Fleet : _intake(step, grid)
    activate Fleet
        Fleet -> TaskSource : poll(step)
        TaskSource --> Fleet : new tasks
        note right of Fleet
          task_id is stamped HERE, not by the source, so
          two sources cannot collide. A target off-grid or
          under a blocking entity is FAILED immediately.
        end note
    deactivate Fleet

    Fleet -> Fleet : _allocate(agents, grid)
    activate Fleet
        loop each eligibility class, restricted classes first
            Fleet -> Allocator : allocate(pending, free, grid)
            Allocator --> Fleet : {task -> agent}
        end
        note right of Fleet
          Restricted first: an unrestricted task could
          otherwise steal an agent reserved by eligibility.
          Matched agents leave the free pool between calls.
        end note
    deactivate Fleet

    Fleet -> Fleet : _build_intent()
    Fleet --> Simulation : DispatchIntent
deactivate Fleet
note right of Simulation
  No dispatcher -> empty DispatchIntent.
  FleetManager never touches the coordinator.
end note

== 3. Coordinated planning ==
Simulation -> Coord : plan(agents, grid, intent)
activate Coord
    note right of Coord
      PIBT: read goals from intent, re-seed base
      priority only if the intent changed, decay,
      rank, recurse (_pibt), reserve next cells
    end note
    Coord --> Simulation : PlanResult
deactivate Coord

== 4. Validate the plan, before any mutation ==
Simulation -> Simulation : _validate(result)
note right of Simulation
  Rejects an inapplicable plan — a target off the grid,
  onto a blocking entity, or claimed by two agents at
  once — BEFORE the grid is touched. The transaction
  below has no rollback, so it must not be able to fail
  halfway and leave agents lifted off the grid.
end note

== 5. Apply moves (lift-then-place transaction) ==
loop each moving agent
    Simulation -> Grid : remove(agent)
end
loop each moving agent
    Simulation -> Agent : move_to(target)
    Simulation -> Grid : place(agent)
end

Simulation --> Caller : PlanResult
deactivate Simulation

note over Simulation, Agent
  Movement authority: the Coordinator decides intent,
  Simulation.step() owns the transaction, Grid + Agent are
  state primitives. agent.move_to alone does NOT touch the
  grid — it is only ever called between grid.remove and
  grid.place, so the spatial index stays in sync.
end note

@enduml
