' =====================================================================
'  SHARED MODEL — included by diagrams.puml, never compiled on its own.
'
'  Two renderings are driven by $ANNOTATED:
'    0 -> simple    : structure only (no stereotypes, no notes)
'    1 -> annotated : + stereotypes + design-pattern notes
'  Multiplicities and relation labels are kept in BOTH renderings, so
'  relations stay plain readable PlantUML.
'
'  PACKAGE DEPENDENCIES (DAG, no cycle):
'    mrta             -> core
'    algo             -> core, mrta          (concrete implementations)
'    client.control   -> core, algo, mrta    (composition root: resolves algo + dispatcher)
'    client.view      -> core, mrta          (VALUE types only: Position, TaskState)
'    client.frontends -> core, client.view   (read-only, via StepSnapshot)
'  mrta NEVER imports algo or client.
'  client.frontends NEVER imports algo, nor any mrta BEHAVIOUR (FleetManager,
'  Allocator, TaskSource) — it only ever sees frozen values.
' =====================================================================

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam ArrowColor #333333
skinparam ClassBorderColor #4A90D9
skinparam ClassBackgroundColor #EAF4FF
skinparam ClassHeaderBackgroundColor #4A90D9
skinparam ClassHeaderFontColor #FFFFFF
skinparam PackageBorderColor #888888
skinparam PackageBackgroundColor #F8F8F8
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #C9B458

' Conditional stereotype: emitted only in the annotated rendering.
!function $st($s)
  !if $ANNOTATED == 1
    !return "<<" + $s + ">>"
  !endif
  !return ""
!endfunction

package "core" #EAF4FF {

    package "entities" {
        class Position $st("value object") {
            + x : int
            + y : int
            --
            + __add__(other: Position) : Position
            + __repr__() : str
        }

        class WorldEntity {
            + entity_id       : int
            + position        : Position
            + appear_at       : int
            + blocks_movement : bool
            + scale           : int = 1
            --
            + active : bool
        }

        class Agent {
            + agent_id    : int
            + steps_taken : int
            --
            + move_to(new_position: Position) : void
            + __eq__(other: object) : bool
            + __hash__() : int
            + __repr__() : str
        }
    }

    package "environment" {
        class Grid {
            + width  : int
            + height : int
            - _agents : dict[Position, Agent]
            - _static : dict[Position, list[WorldEntity]]
            --
            + is_valid(position: Position) : bool
            + is_blocked(position: Position) : bool
            + place(entity: WorldEntity) : void
            + remove(entity: WorldEntity) : void
            + get_agent_at(position: Position) : Agent | None
            + get_entities_at(position: Position, kind) : list[WorldEntity]
            + get_all(kind) : list[WorldEntity]
            + __repr__() : str
        }
    }

    package "engine" {
        class PlanResult $st("DTO") {
            + positions   : dict[int, Position]
            + moves       : dict[int, tuple]
            + order       : list[int]
            + inheritance : list[tuple]
            + priorities  : dict[int, float]
        }

        class DispatchIntent $st("DTO") {
            + goals      : dict[int, Position]
            + priorities : dict[int, float]
        }

        abstract class Coordinator $st("Strategy") {
            + {abstract} plan(agents: list[Agent], grid: Grid, intent: DispatchIntent) : PlanResult
        }

        abstract class Dispatcher $st("Strategy") {
            + {abstract} dispatch(agents: list[Agent], grid: Grid, step: int) : DispatchIntent
        }

        class StaticDispatcher {
            - _intent : DispatchIntent
            --
            + dispatch(agents: list[Agent], grid: Grid, step: int) : DispatchIntent
        }

        class Simulation {
            + grid         : Grid
            + agents       : list[Agent]
            + entities     : list[WorldEntity]
            - _pending     : list[WorldEntity]
            + current_step : int
            + coordinator  : Coordinator
            + dispatcher   : Dispatcher | None
            + last_intent  : DispatchIntent
            --
            + add_agent(agent: Agent) : void
            + add_object(entity: WorldEntity) : void
            + step() : PlanResult
            + __repr__() : str
        }
    }
}

package "client" #FFF5EA {

    ' ── PART 1: scripting API (pygame-free, reusable by any script) ──
    package "control" {
        class ScenarioConfig $st("value object") {
            + width    : int = 15
            + height   : int = 15
            + n_agents : int = 20
            + algo     : str = "pibt"
            + mode     : str = "mrta"
            + steps    : int
            + seed     : int
        }

        class SimulationFactory $st("Factory") {
            + {static} build(config: ScenarioConfig) : SimulationController
        }

        class SimulationController $st("Facade") {
            + sim    : Simulation
            + config : ScenarioConfig
            - _tasks : QueueTaskSource | None
            --
            + step() : StepSnapshot
            + run(steps: int) : list[StepSnapshot]
            + send_batch_to(target: Position, agent_ids: list[int], count: int) : list[Task]
            + snapshot() : StepSnapshot
            - _ring_cells(target: Position, count: int) : list[Position]
        }
    }

    package "view" {
        class TaskView $st("value object") {
            + task_id      : int
            + target       : Position
            + priority     : float
            + state        : TaskState
            + assignee_id  : int | None
            + created_step : int
        }

        class StepSnapshot $st("DTO") {
            + step    : int
            + result  : PlanResult
            + goals   : dict[int, Position]
            + objects : list[tuple]
            + tasks   : list[TaskView]
        }
    }

    ' ── PART 2: presentation only (knows neither algo nor mrta) ──────
    package "frontends" {
        abstract class Frontend $st("Strategy") {
            + controller : SimulationController
            --
            + {abstract} run() : void
        }

        class PygameFrontend {
            - _cell    : int
            - _sidebar : Sidebar
            --
            + run() : void
            - _fit_cell_size() : int
            - _draw_grid(snap: StepSnapshot) : void
            - _draw_tasks(snap: StepSnapshot) : void
        }

        class Sidebar {
            - _selected : set[int]
            - _target   : Position | None
            --
            + handle_event(event) : void
            + draw(surface, snap: StepSnapshot) : void
            - _send_batch() : void
        }

        class HeadlessFrontend {
            + run() : void
            - _print_snapshot(snap: StepSnapshot) : void
        }
    }
}

package "mrta" #FFF0F5 {

    enum TaskState {
        PENDING
        ASSIGNED
        DONE
    }

    class Task {
        + task_id      : int
        + target       : Position
        + priority     : float
        + state        : TaskState
        + assignee     : Agent | None
        + created_step : int
    }

    abstract class TaskSource $st("Strategy") {
        + {abstract} poll(current_step: int) : list[Task]
    }

    class QueueTaskSource {
        - _queue   : list[Task]
        - _next_id : int
        --
        + push(target: Position, priority: float) : Task
        + push_many(targets: list[Position], priority: float) : list[Task]
        + poll(current_step: int) : list[Task]
    }

    class RandomTaskSource {
        - _rng  : Random
        - _rate : float
        - _grid : Grid
        --
        + poll(current_step: int) : list[Task]
    }

    class ScriptedTaskSource {
        - _schedule : dict[int, list[Task]]
        --
        + poll(current_step: int) : list[Task]
    }

    abstract class Allocator $st("Strategy") {
        + {abstract} allocate(pending: list[Task], free: list[Agent], grid: Grid) : dict[Task, Agent]
    }

    class FleetManager {
        + source    : TaskSource
        + allocator : Allocator
        + tasks     : list[Task]
        --
        + dispatch(agents: list[Agent], grid: Grid, step: int) : DispatchIntent
        + set_priority(task_id: int, priority: float) : void
        - _intake(step: int) : void
        - _allocate(agents: list[Agent], grid: Grid) : void
        - _complete(agents: list[Agent]) : void
        - _prune() : void
        - _build_intent() : DispatchIntent
    }
}

package "algo" #F0FFF0 {

    package "coordination" {
        class RandomWalkCoordinator {
            --
            + plan(agents: list[Agent], grid: Grid, intent: DispatchIntent) : PlanResult
        }

        class ReservationTable {
            - _reserved : dict[Position, Agent]
            --
            + reserve(agent: Agent, pos: Position) : void
            + release(agent: Agent) : void
            + get_reserving_agent(pos: Position) : Agent | None
            + get_reservation(agent: Agent) : Position | None
            + clear() : void
        }

        class PriorityManager {
            - _base    : dict[Agent, float]
            - _dynamic : dict[Agent, float]
            --
            + update(agents: list[Agent]) : void
            + get_priority(agent: Agent) : float
            + set_base(agent: Agent, p: float) : void
        }

        class PIBTCoordinator {
            + goals         : dict[Agent, Position]
            - _reservations : ReservationTable
            - _priorities   : PriorityManager
            - _processed    : set[Agent]
            - _inheritance  : list[tuple[Agent, Agent]]
            - _last_intent  : dict[int, tuple]
            --
            + plan(agents: list[Agent], grid: Grid, intent: DispatchIntent) : PlanResult
            - _apply_intent(agents: list[Agent], intent: DispatchIntent) : void
            - _pibt(agent: Agent, parent: Agent | None, grid: Grid) : bool
            - _h(pos: Position, agent: Agent, grid: Grid) : int
        }
    }

    package "allocation" {
        class RandomAllocator {
            --
            + allocate(pending: list[Task], free: list[Agent], grid: Grid) : dict[Task, Agent]
        }

        class KDTreeGreedyAllocator {
            - _tree : KDTree
            --
            + allocate(pending: list[Task], free: list[Agent], grid: Grid) : dict[Task, Agent]
            - _nearest_free(task: Task, free: list[Agent]) : Agent
        }
    }
}

' ── Inheritance & entities ────────────────────────────────────────
WorldEntity <|-- Agent
WorldEntity "1" *-- "1" Position : position

' ── Grid ──────────────────────────────────────────────────────────
Grid "1" *-- "0..*" WorldEntity : "> contain"

' ── Engine: simulation loop ───────────────────────────────────────
Simulation "1" *-- "1" Grid           : grid
Simulation "1" *-- "0..*" WorldEntity : entities
Simulation "1" o-- "1" Coordinator    : coordinator
Simulation "1" o-- "0..1" Dispatcher  : dispatcher (optional)
Simulation "1" *-- "1" DispatchIntent : last_intent
Coordinator ..> PlanResult : «returns»
Coordinator ..> DispatchIntent : «reads»

' ── Coordinator hierarchy (Strategy) ──────────────────────────────
Coordinator <|.. RandomWalkCoordinator
Coordinator <|.. PIBTCoordinator

' ── PIBT decomposition (Extract-Class) ────────────────────────────
PIBTCoordinator "1" *-- "1" ReservationTable : _reservations
PIBTCoordinator "1" *-- "1" PriorityManager  : _priorities

' ── Client PART 1: the scripting API (composition root) ───────────
SimulationFactory ..> ScenarioConfig       : «reads»
SimulationFactory ..> SimulationController : «creates»
SimulationController "1" o-- "1" Simulation         : sim
SimulationController "1" *-- "1" ScenarioConfig     : config
SimulationController "1" o-- "0..1" QueueTaskSource : _tasks (MRTA mode)
SimulationController ..> StepSnapshot : «builds»
SimulationController ..> TaskView    : «projects Task ->»
StepSnapshot "1" *-- "1" PlanResult  : result
StepSnapshot "1" *-- "0..*" TaskView : tasks
TaskView ..> TaskState : state

' ── Client PART 2: front-ends, decoupled from algo & mrta ─────────
Frontend "1" o-- "1" SimulationController : controller
Frontend <|.. PygameFrontend
Frontend <|.. HeadlessFrontend
Frontend ..> StepSnapshot : «reads»
PygameFrontend "1" *-- "1" Sidebar : _sidebar
Sidebar ..> SimulationController : «send_batch_to»

' ── MRTA ──────────────────────────────────────────────────────────
Task "1" *-- "1" TaskState : state

Allocator <|.. RandomAllocator
Allocator <|.. KDTreeGreedyAllocator

TaskSource <|.. QueueTaskSource
TaskSource <|.. RandomTaskSource
TaskSource <|.. ScriptedTaskSource

Dispatcher <|.. FleetManager
Dispatcher <|.. StaticDispatcher
Dispatcher ..> DispatchIntent : «returns»
FleetManager "1" o-- "1" TaskSource : source
FleetManager "1" o-- "1" Allocator  : allocator
FleetManager "1" *-- "0..*" Task    : tasks

' =====================================================================
'  NOTES — annotated rendering only
' =====================================================================
!if $ANNOTATED == 1

note bottom of PlanResult
  **Data Transfer Object (DTO) — unified return of plan()**
  Cross-algorithm comparison standard:
  • positions, moves = universal contract (every Coordinator)
  • order, inheritance, priorities = optional
    diagnostics (empty outside the PIBT family)
  Crosses the core→client boundary: it is what keeps
  the front-ends decoupled from `algo`.
end note

note bottom of DispatchIntent
  **Data Transfer Object (DTO) — allocation contract**
  Absolute goals/priorities wanted this tick (agent_id-keyed).
  It replaces external mutation of the coordinator:
  • FleetManager RETURNS it (no coordinator reference)
  • plan() READS it (priorities ignored by goal-less algos)
  Decouples allocation from navigation: any Coordinator
  (even RandomWalk) can be paired with any Dispatcher.
end note

note bottom of PIBTCoordinator
  **Extract-Class**: PIBT is split into focused classes.
  Reservations -> ReservationTable
  Priorities   -> PriorityManager
  The core (_pibt / _h) receives `grid` as an argument
  (no grid state is stored).
end note

note top of FleetManager
  **Control loop — owned by Simulation.step()**:
  1. dispatch (if a dispatcher is attached):
     _complete -> _intake -> _allocate -> return DispatchIntent
  2. coordinator.plan(intent) -> PlanResult
  3. apply moves (grid.remove -> agent.move_to -> grid.place)
  FleetManager holds NO coordinator reference — it is pure
  w.r.t. the engine. mrta depends only on core
  (Dispatcher, DispatchIntent, Task, Position).
  _prune() drops DONE tasks: without it `tasks` grows
  unboundedly and every tick is O(total tasks ever created).
end note

note right of Dispatcher
  **Orchestration seam (Dependency Inversion)**
  Pre-planning hook: Simulation.step() calls dispatch()
  BEFORE plan(), passing the returned DispatchIntent to it,
  so goals are never stale by construction. Living in core
  lets Simulation own the tick order (dispatch -> plan)
  WITHOUT importing mrta — like Coordinator. FleetManager
  and StaticDispatcher are the concrete dispatchers.
end note

note bottom of Simulation
  **Deliberate deviation from the simplified rendering**
  step() returns the step's PlanResult (not void):
  the only way for front-ends to read PIBT diagnostics
  without importing `algo` from `client`.
end note

note left of ReservationTable
  **Deliberate deviations from the simplified rendering**
  release(agent): frees an agent's reservation during
  backtracking (next candidate tried by _pibt).
  get_reservation(agent): reads the cell reserved by an
  agent — used to assemble PlanResult.positions and for
  the anti-recursion guard (sigma defined <=> existing
  reservation).
end note

note right of TaskSource
  **Strategy — where work comes from**
  QueueTaskSource   : fed from outside (sidebar, scripts)
  RandomTaskSource  : autonomous runs & benchmarks (seeded)
  ScriptedTaskSource: {step: [Task]} — deterministic tests
  Until these existed, mrta was abstract-only and
  FleetManager was not instantiable anywhere.
end note

note right of SimulationController
  **Facade — PART 1 of client: the scripting API**
  The single mounting point of a simulation, reusable by
  ANY script (demos, benchmarks, front-ends). This is the
  composition root: the only place that knows core + algo
  + mrta at once, which is what lets the front-ends stay
  ignorant of both.
  send_batch_to() = send a batch of agents to B or its
  surroundings — the central interactive primitive.
end note

note bottom of Sidebar
  **The sidebar is NOT a Dispatcher**
  Sending a batch to B is a task-ALLOCATION problem, so the
  sidebar is a task SOURCE, not a rival source of goals:
    Sidebar -> QueueTaskSource -> FleetManager
            -> DispatchIntent  -> PIBTCoordinator
  Nothing bypasses the planner, so batch moves inherit
  collision avoidance for free, and the coordinator is
  never mutated from outside.
end note

note right of TaskView
  **A snapshot must hold values, never live references**
  StepSnapshot once carried `list[Task]`. A Task is mutable
  and owned by FleetManager, which keeps mutating it
  (ASSIGNED -> DONE) and eventually prunes it — so a stored
  snapshot silently rewrote its own past, and
  `tasks[i].assignee.position` (live) contradicted
  `result.positions[id]` (frozen) inside the SAME snapshot.
  TaskView flattens it: frozen fields, `assignee_id` as an
  int. Same rule PlanResult already follows by keying on
  agent_id instead of exposing Agent.
  Only an OBJECT diagram exposes this: aliasing is a
  property of identity, invisible on a class diagram.
end note

note top of Frontend
  **PART 2 of client: presentation only**
  Knows neither algo nor mrta — reads StepSnapshot and
  calls the controller. Adding a front-end (web, ROS
  bridge, ...) requires no change to core/algo/mrta.
  PygameFrontend replaces the three former renderers,
  whose grid-drawing code was duplicated three times.
end note

!endif
