@startuml class_diag_simplified

title Simulation — Simplified engine class diagram

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam ArrowColor #333333
skinparam ClassBorderColor #4A90D9
skinparam ClassBackgroundColor #EAF4FF
skinparam ClassHeaderBackgroundColor #4A90D9
skinparam ClassHeaderFontColor #FFFFFF
skinparam PackageBorderColor #888888
skinparam PackageBackgroundColor #F8F8F8

package "core" #EAF4FF {

    package "entities" {
        class Coordinates2D {
            + x : int
            + y : int
            --
            + __add__(other: Coordinates2D) : Coordinates2D
        }

        enum Orientation {
            NORTH
            EAST
            SOUTH
            WEST
        }

        abstract class WorldEntity {
            + entity_id       : int
            + position        : Coordinates2D
            + appear_at       : int
            + blocks_movement : bool
            --
            + is_active : bool
        }

        class Agent {
            + agent_id    : int
            + steps_taken : int
            + orientation : Orientation
            --
            + move_to(new_position: Coordinates2D) : void
            + rotate_to(new_orientation: Orientation) : void
        }

        class Objective {
            --
            + attach_to(agent: Agent) : void
        }

    }

    package "environment" {
        class Grid2D {
            + width  : int
            + height : int
            --
            + is_within_bounds(position: Coordinates2D) : bool
            + is_blocked(position: Coordinates2D) : bool
            + place(entity: WorldEntity) : void
            + unindex(entity: WorldEntity) : void
            + agent_at(position: Coordinates2D) : Agent | None
        }
    }

    package "engine" {
        class AssignmentManifest {
            + goals      : list[Objective]
            + priorities : dict[int, float]
        }

        class WorldEngine {
            + grid         : Grid2D
            + agents       : list[Agent]
            + planner      : PathPlanner
            + orchestrator : MissionOrchestrator | None
            + current_step : int
            --
            + register_agent(agent: Agent) : void
            + spawn_static_obstacle(entity: WorldEntity) : void
            + advance_time_step() : StepOutcome
        }

        abstract class PathPlanner {
            + plan(agents: list[Agent], grid: Grid2D, intent: AssignmentManifest) : StepOutcome
        }

        abstract class MissionOrchestrator {
            + assign_missions(agents: list[Agent], grid: Grid2D, step: int) : AssignmentManifest
        }
    }
}

' ── Simplified High-Level Relations ─────────────────────────────

WorldEntity <|-- Agent
WorldEntity <|-- Objective
WorldEntity *-- Coordinates2D
Agent *-- Orientation
Objective --> Agent : assignee
AssignmentManifest o-- Objective : goals
Grid2D o-- WorldEntity
WorldEngine *-- Grid2D
WorldEngine *-- Agent
WorldEngine *-- PathPlanner
WorldEngine *-- MissionOrchestrator

@enduml
