' =====================================================================
'  Annotated class diagram — self-contained (single file, no !include).
'
'  This used to be one of two renderings driven off a shared _model.iuml
'  (via diagrams.puml, toggled by $ANNOTATED). The "simple" rendering was
'  dropped as redundant with class_diag_simplified.puml, which already
'  covers that role as its own hand-curated diagram; $ANNOTATED is kept
'  and hardcoded to 1 below so this file's content — classes, relations,
'  stereotypes, notes, legend — stays byte-for-byte what the annotated
'  rendering already was.
'
'  Regenerate with:
'      plantuml diagrammes/Class_Diagram/class_diag_commented.puml
'
'  Output:
'      class_diag_commented.png
' =====================================================================

@startuml simulation_class_diagram_commente
!$ANNOTATED = 1
title Simulation — Class diagram (annotated: context & design patterns)

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam ArrowColor #333333
skinparam ClassBorderColor #4A90D9
skinparam ClassBackgroundColor #EAF4FF
skinparam ClassHeaderBackgroundColor #4A90D9
skinparam ClassHeaderFontColor #FFFFFF
skinparam PackageBorderColor #888888
skinparam PackageBackgroundColor #F8F8F8
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #C9B458
skinparam linetype ortho

' Conditional stereotype: emitted only in the annotated rendering.
!function $st($s)
  !if $ANNOTATED == 1
    !return "<<" + $s + ">>"
  !endif
  !return ""
!endfunction

' =====================================================================
'  core — the world and the tick that advances it
' =====================================================================
package "core" #EAF4FF {

    package "entities" {
        class Coordinates2D $st("value object") {
            + x : int
            + y : int
            --
            + __add__(other: Coordinates2D) : Coordinates2D
        }

        class SpatialEntity {
            + entity_id       : int
            + position        : Coordinates2D
            + appear_at       : int
            + blocks_movement : bool
            + scale           : int = 1
            --
            + is_active : bool
        }

        class Agent {
            + agent_id    : int
            + steps_taken : int
            --
            + move_to(new_position: Coordinates2D) : void
        }

        class NamedRegion {
            + name  : str
            + cells : tuple[Coordinates2D]
            --
            + contains(position: Coordinates2D) : bool
        }
        !if $ANNOTATED == 1
        note bottom of NamedRegion
          **A named region — "send the fleet to the loading station"**
          A group of cells the operator can address by name instead of
          by coordinates: loading station, working space, empty-rack
          area. Like any SpatialEntity it can spawn late and go inactive;
          unlike the others it covers several cells, so the grid knows
          it at each of them rather than at a single corner.
        end note
        !endif
    }

    package "environment" {
        class SpatialIndex {
            + width  : int
            + height : int
            - _agents : dict[Coordinates2D, Agent]
            - _static : dict[Coordinates2D, list[SpatialEntity]]
            --
            + is_within_bounds(position: Coordinates2D) : bool
            + is_blocked(position: Coordinates2D) : bool
            + place(entity: SpatialEntity) : void
            + unindex(entity: SpatialEntity) : void
            + agent_at(position: Coordinates2D) : Agent | None
        }
    }

    package "engine" {
        class StepOutcome $st("DTO") {
            + positions   : dict[int, Coordinates2D]
            + moves       : dict[int, tuple]
            + order       : list[int]
            + inheritance : list[tuple]
            + priorities  : dict[int, float]
        }

        class AssignmentManifest $st("DTO") {
            + goals      : dict[int, Coordinates2D]
            + priorities : dict[int, float]
        }
        !if $ANNOTATED == 1
        note bottom of AssignmentManifest
          **The only channel between the two sides**
          One tick's complete answer to "where should everyone go?" —
          a goal and an optional priority per agent, frozen.
          Nothing else may set a planner's goals, so any MissionOrchestrator
          pairs with any PathPlanner, and every tick leaves an
          auditable record of what was asked.
        end note
        !endif

        abstract class PathPlanner $st("Strategy") {
            + {abstract} plan(agents: list[Agent], grid: SpatialIndex, intent: AssignmentManifest) : StepOutcome
        }

        abstract class MissionOrchestrator $st("Strategy") {
            + {abstract} assign_missions(agents: list[Agent], grid: SpatialIndex, step: int) : AssignmentManifest
        }
        !if $ANNOTATED == 1
        note bottom of MissionOrchestrator
          **The two questions of the simulation, kept apart**
          MissionOrchestrator answers WHERE each robot should go — a
          business decision: which job matters, who is free.
          PathPlanner answers HOW they get there — a geometric one:
          paths and collisions.
          Both are abstract and live in core, so the engine runs a tick
          without knowing that task allocation or PIBT exist. Swap
          either side and the other is unaffected.
        end note
        !endif

        class FixedGoalDispatcher {
            - _intent : AssignmentManifest
            --
            + assign_missions(agents: list[Agent], grid: SpatialIndex, step: int) : AssignmentManifest
        }

        class WorldEngine {
            + grid         : SpatialIndex
            + agents       : list[Agent]
            + entities     : list[SpatialEntity]
            - _pending     : list[SpatialEntity]
            + current_step : int
            + coordinator  : PathPlanner
            + dispatcher   : MissionOrchestrator | None
            + last_intent  : AssignmentManifest
            --
            + register_agent(agent: Agent) : void
            + spawn_static_obstacle(entity: SpatialEntity) : void
            + advance_time_step() : StepOutcome
        }
        !if $ANNOTATED == 1
        note top of WorldEngine
          **The engine — one tick of the world**
          Every step runs the same three phases, in this order:
            1. **assign missions** — ask the MissionOrchestrator where each agent goes
            2. **plan**            — ask the PathPlanner how to move them there
            3. **move**            — apply the plan to the grid
          Because the engine owns that order, goals can never be stale
          and a caller cannot plan before assigning missions. All agents
          move inside one transaction, so two of them can swap cells
          without either seeing the grid half-updated.
        end note
        !endif
    }
}

' =====================================================================
'  mrta — Multi-Robot Task Allocation: who does what
' =====================================================================
package "mrta" #FFF0F5 {

    enum MissionState {
        PENDING
        ASSIGNED
        DONE
        FAILED
    }

    class Mission {
        + task_id               : int
        + target                : Coordinates2D
        + priority              : float
        + state                 : MissionState
        + assignee              : Agent | None
        + created_step          : int
        + eligible              : frozenset[int] | None
        + attempts              : int
        + best_distance         : int | None
        + last_improvement_step : int
    }

    abstract class MissionSource $st("Strategy") {
        + {abstract} fetch_new_missions(current_step: int) : list[Mission]
    }
    !if $ANNOTATED == 1
    note left of MissionSource
      **Where the work comes from**
      A run can be fed by a human, a generator or a script — the fleet
      does not care which:
        QueueMissionSource     — pushed from outside (a click, a script)
        RandomMissionSource    — seeded background load, for benchmarks
        ScriptedMissionSource  — a fixed {step: missions} schedule, for tests
        CompositeMissionSource — several at once (manual AND background)
    end note
    !endif

    class QueueMissionSource {
        - _queue : list[Mission]
        --
        + push(task: Mission) : void
        + push_many(tasks: list[Mission]) : void
        + fetch_new_missions(current_step: int) : list[Mission]
    }

    class RandomMissionSource {
        - _grid  : SpatialIndex
        - _every : int
        - _count : int
        - _rng   : Random
        --
        + fetch_new_missions(current_step: int) : list[Mission]
    }

    class ScriptedMissionSource {
        - _schedule : dict[int, list[Mission]]
        --
        + fetch_new_missions(current_step: int) : list[Mission]
    }

    class CompositeMissionSource {
        + sources : list[MissionSource]
        --
        + fetch_new_missions(current_step: int) : list[Mission]
    }

    abstract class AssignmentStrategy $st("Strategy") {
        + {abstract} match_missions_to_units(pending: list[Mission], free: list[Agent], grid: SpatialIndex) : dict[Mission, Agent]
    }
    !if $ANNOTATED == 1
    note right of AssignmentStrategy
      **Who takes which job**
      The matching strategy, isolated so variants can be compared:
      pending missions and idle robots in, mission -> robot pairs out.
      Whichever implementation is plugged in, it never decides
      *whether* a robot is allowed to take a job: TaskDrivenOrchestrator
      has already filtered that before it calls it.
      No concrete implementation exists currently — see TODO.md.
    end note
    !endif

    class TaskDrivenOrchestrator {
        + source          : MissionSource
        + allocator       : AssignmentStrategy
        + patience        : int
        + max_attempts    : int
        + tasks           : list[Mission]
        + completed_count : int
        + failed_count    : int
        --
        + assign_missions(agents: list[Agent], grid: SpatialIndex, step: int) : AssignmentManifest
        + set_mission_priority(task_id: int, priority: float) : void
    }
    !if $ANNOTATED == 1
    note bottom of TaskDrivenOrchestrator
      **The fleet's memory — it is the MissionOrchestrator in task mode**
      Each tick it collects new missions, marks arrived ones DONE, hands
      the rest to the AssignmentStrategy, and publishes the result as an
      AssignmentManifest. A mission lives PENDING -> ASSIGNED -> DONE, or
      ends FAILED.

      **Why FAILED exists.** An assigned agent is no longer available,
      so a mission aiming at an unreachable cell would hold a robot
      hostage forever while the fleet still looked healthy. Two guards
      prevent it:
        at intake — a target off-grid or under an obstacle is rejected
        watchdog  — an assignee that gets no closer for `patience`
                    steps is released and the mission retried; after
                    `max_attempts` assignees the mission is FAILED
      Progress is *observed* rather than reachability *proven*:
      obstacles can appear mid-run, so any proof would be stale and
      would duplicate the planner. Failed missions are counted, never
      silently dropped.
    end note
    !endif
}

' ── Diamond convention ────────────────────────────────────────────
' One rule, applied throughout, so the diamonds carry information
' instead of being decided case by case:
'
'   filled  (*--)  an IMMUTABLE value, held by value — sharing the same
'                  instance is meaningless, so ownership is moot
'                  (Coordinates2D, AssignmentManifest, StepOutcome) —
'                  or a MUTABLE object with a single, exclusive owner
'                  (WorldEngine's entities, TaskDrivenOrchestrator's tasks).
'   hollow  (o--)  a MUTABLE object whose instance is SHARED. The holder
'                  reads or indexes it; something else governs its life.
'
' The two edges that changed under this rule are SpatialIndex -> SpatialEntity
' and WorldEngine -> SpatialIndex; see the comments on each.

' ── Inheritance & entities ────────────────────────────────────────
SpatialEntity <|-- Agent
SpatialEntity <|-- NamedRegion
SpatialEntity "1" *-- "1" Coordinates2D : position
' Filled diamond: Coordinates2D is immutable, so sharing an instance is
' meaningless and ownership is moot — the same rule as above.
NamedRegion "1" *-- "1..*" Coordinates2D : cells

' ── SpatialIndex ──────────────────────────────────────────────────
' Aggregation, not composition: SpatialIndex is a spatial INDEX, not a
' store. An entity lives in WorldEngine.entities (and in _pending, before
' the grid has ever seen it), and grid.unindex(agent) during the lift
' phase of a step does not end its life — it un-indexes it for a few
' lines. A filled diamond here would claim the opposite, and would also
' contradict WorldEngine *-- SpatialEntity just below: two exclusive
' owners of one object cannot both be right.
SpatialIndex "1" o-- "0..*" SpatialEntity : "> index"

' ── Engine: simulation loop ───────────────────────────────────────
' Aggregation: whatever builds the scenario hands the same SpatialIndex
' instance to WorldEngine and to RandomMissionSource, which reads it to
' find free cells. WorldEngine drives the grid; it does not own it
' exclusively.
WorldEngine "1" o-- "1" SpatialIndex        : grid
WorldEngine "1" *-- "0..*" SpatialEntity    : entities
WorldEngine "1" o-- "1" PathPlanner         : coordinator
WorldEngine "1" o-- "0..1" MissionOrchestrator : dispatcher (optional)
WorldEngine "1" *-- "1" AssignmentManifest  : last_intent
PathPlanner ..> StepOutcome : «returns»
PathPlanner ..> AssignmentManifest : «reads»

' ── MRTA ──────────────────────────────────────────────────────────
Mission "1" *-- "1" MissionState : state

MissionSource <|.. QueueMissionSource
MissionSource <|.. RandomMissionSource
MissionSource <|.. ScriptedMissionSource
MissionSource <|.. CompositeMissionSource
CompositeMissionSource "1" o-- "1..*" MissionSource : sources

MissionOrchestrator <|.. TaskDrivenOrchestrator
MissionOrchestrator <|.. FixedGoalDispatcher
MissionOrchestrator ..> AssignmentManifest : «returns»
TaskDrivenOrchestrator "1" o-- "1" MissionSource      : source
TaskDrivenOrchestrator "1" o-- "1" AssignmentStrategy : allocator
TaskDrivenOrchestrator "1" *-- "0..*" Mission         : tasks

' ── Layout constraint: keep the engine and the fleet adjacent ─────
' Declaration order alone is a weak hint — dot re-orders clusters
' freely. This hidden edge pins one rank, left to right: the grid, the
' engine that advances it, and the fleet that feeds it goals — so core
' and mrta land side by side instead of dot picking an arbitrary order.
SpatialIndex -[hidden]right- WorldEngine
WorldEngine -[hidden]right- TaskDrivenOrchestrator

' =====================================================================
'  Page-level legend — the 30-second read, annotated rendering only.
' =====================================================================
!if $ANNOTATED == 1
legend bottom left
  **What this project simulates**
  A fleet of robots moving on a grid. Jobs appear somewhere on the map;
  the fleet decides //which robot takes which job// (allocation), then a
  MAPF algorithm decides //how they all get there without colliding//
  (coordination). Read the packages in this order:
    **core**   the world (grid, agents) and the tick that advances it
    **mrta**   Multi-Robot Task Allocation — who does what
  There is currently no concrete PathPlanner or AssignmentStrategy
  implementation and no supported way to drive or watch a run end to
  end — see TODO.md.
end legend
!endif

@enduml
