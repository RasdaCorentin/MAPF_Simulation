@startuml class_diag_simplified

title Simulation — Simplified class diagram

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam ArrowColor #333333
skinparam ClassBorderColor #4A90D9
skinparam ClassBackgroundColor #EAF4FF
skinparam ClassHeaderBackgroundColor #4A90D9
skinparam ClassHeaderFontColor #FFFFFF
skinparam PackageBorderColor #888888
skinparam PackageBackgroundColor #F8F8F8

package "core" #EAF4FF {

    package "entities" {
        class Coordinates2D {
            + x : int
            + y : int
            --
            + __add__(other: Coordinates2D) : Coordinates2D
        }

        abstract class SpatialEntity {
            + entity_id       : int
            + position        : Coordinates2D
            + appear_at       : int
            + blocks_movement : bool
            --
            + is_active : bool
        }

        class Agent {
            + agent_id    : int
            + steps_taken : int
            --
            + move_to(new_position: Coordinates2D) : void
        }

        class NamedRegion {
            + name  : str
            + cells : tuple[Coordinates2D]
            --
            + contains(position: Coordinates2D) : bool
        }
    }

    package "environment" {
        class SpatialIndex {
            + width  : int
            + height : int
            --
            + is_within_bounds(position: Coordinates2D) : bool
            + is_blocked(position: Coordinates2D) : bool
            + place(entity: SpatialEntity) : void
            + unindex(entity: SpatialEntity) : void
            + agent_at(position: Coordinates2D) : Agent | None
        }
    }

    package "engine" {
        class WorldEngine {
            + grid         : SpatialIndex
            + agents       : list[Agent]
            + coordinator  : PathPlanner
            + dispatcher   : MissionOrchestrator | None
            + current_step : int
            --
            + register_agent(agent: Agent) : void
            + spawn_static_obstacle(entity: SpatialEntity) : void
            + advance_time_step() : StepOutcome
        }

        abstract class PathPlanner {
            + plan(agents: list[Agent], grid: SpatialIndex, intent: AssignmentManifest) : StepOutcome
        }

        abstract class MissionOrchestrator {
            + assign_missions(agents: list[Agent], grid: SpatialIndex, step: int) : AssignmentManifest
        }
    }
}

package "mrta" #FFF0F5 {

    enum MissionState {
        PENDING
        ASSIGNED
        DONE
        FAILED
    }

    class Mission {
        + task_id  : int
        + target   : Coordinates2D
        + priority : float
        + state    : MissionState
        + assignee : Agent | None
    }

    abstract class MissionSource {
        + fetch_new_missions(current_step: int) : list[Mission]
    }

    abstract class AssignmentStrategy {
        + match_missions_to_units(pending: list[Mission], free: list[Agent], grid: SpatialIndex) : dict[Mission, Agent]
    }

    class TaskDrivenOrchestrator {
        + source    : MissionSource
        + allocator : AssignmentStrategy
        + tasks     : list[Mission]
        --
        + assign_missions(agents: list[Agent], grid: SpatialIndex, step: int) : AssignmentManifest
    }
}

' ── Simplified High-Level Relations ─────────────────────────────

SpatialEntity <|-- Agent
SpatialEntity <|-- NamedRegion
SpatialEntity *-- Coordinates2D
SpatialIndex o-- SpatialEntity
WorldEngine *-- SpatialIndex
WorldEngine *-- Agent
WorldEngine *-- PathPlanner
WorldEngine *-- MissionOrchestrator

Mission *-- MissionState

MissionOrchestrator <|-- TaskDrivenOrchestrator
TaskDrivenOrchestrator o-- MissionSource
TaskDrivenOrchestrator o-- AssignmentStrategy
TaskDrivenOrchestrator *-- Mission

@enduml
