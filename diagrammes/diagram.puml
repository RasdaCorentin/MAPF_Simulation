@startuml simulation_class_diagram

title Simulation — Diagramme de classes

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam ArrowColor #333333
skinparam ClassBorderColor #4A90D9
skinparam ClassBackgroundColor #EAF4FF
skinparam ClassHeaderBackgroundColor #4A90D9
skinparam ClassHeaderFontColor #FFFFFF
skinparam PackageBorderColor #888888
skinparam PackageBackgroundColor #F8F8F8

package "core" #EAF4FF {

    class Position {
        + x : int
        + y : int
        --
        + __add__(other: Position) : Position
        + __repr__() : str
    }

    abstract class WorldEntity {
        + entity_id      : int
        + position       : Position
        + appear_at      : int
        + blocks_movement : bool
        --
        + active : bool
    }

    class Agent {
        + agent_id    : int
        + steps_taken : int
        --
        + move_to(new_position: Position) : void
        + __eq__(other: object) : bool
        + __hash__() : int
        + __repr__() : str
    }

    class Objective {
        + owner     : Agent | None
        + collected : bool
        --
        + active : bool
        + __repr__() : str
    }

    class Grid {
        + width  : int
        + height : int
        - _agents : dict[Position, Agent]
        - _static : dict[Position, list[WorldEntity]]
        --
        + is_valid(position: Position) : bool
        + is_blocked(position: Position) : bool
        + place(entity: WorldEntity) : void
        + remove(entity: WorldEntity) : void
        + move(agent: Agent, new_position: Position) : bool
        + get_agent_at(position: Position) : Agent | None
        + get_entities_at(position: Position, kind) : list[WorldEntity]
        + get_all(kind) : list[WorldEntity]
        + __repr__() : str
    }

    class Simulation {
        + grid         : Grid
        + agents       : list[Agent]
        + entities     : list[WorldEntity]
        - _pending     : list[WorldEntity]
        + current_step : int
        + coordinator  : Coordinator
        --
        + add_agent(agent: Agent) : void
        + add_object(entity: WorldEntity) : void
        + step() : void
        + __repr__() : str
    }

    abstract class Coordinator {
        + plan(agents: list[Agent], grid: Grid) : dict[int, Position]
    }

    WorldEntity <|-- Agent
    WorldEntity <|-- Objective

    WorldEntity "1" *-- "1" Position : position
    Grid "1" o-- "0..*" Agent       : _agents
    Grid "1" o-- "0..*" WorldEntity : _static
    Grid ..> Position : uses
    Simulation "1" *-- "1" Grid        : grid
    Simulation "1" *-- "0..*" Agent    : agents
    Simulation "1" *-- "0..*" WorldEntity : entities
    Simulation "1" *-- "1" Coordinator : coordinator
}

package "client" #FFF5EA {

    class Renderer {
        + sim : Simulation
        --
        + run(steps: int, pause: float) : void
        - _draw(screen, font, font_sm, font_hdr, w, h) : void
    }

    class PIBTRenderer {
        + pibt : PIBT
        --
        - _draw(screen, font, font_sm, font_hdr, w, h) : void
    }

    class StepSnapshot {
        + step        : int
        + positions   : dict[int, Position]
        + priorities  : dict[int, float]
        + order       : list[int]
        + moves       : dict[int, tuple]
        + inheritance : list[tuple]
        + objects     : list[tuple]
        + goals       : dict[int, Position]
    }

    class PIBTInteractiveRenderer {
        + sim  : Simulation
        + pibt : PIBT
        --
        + run(steps: int, auto_ms: int) : void
        - _build_history(steps: int) : list[StepSnapshot]
        - _snapshot_objects() : list[tuple]
        - _run_loop(history, auto_ms) : void
        - _draw_header(...) : void
        - _draw_grid(...) : void
        - _draw_footer(...) : void
    }
}

package "algo" #F0FFF0 {

    class RandomWalkCoordinator {
        --
        + plan(agents: list[Agent], grid: Grid) : dict[int, Position]
    }

    class PIBT {
        + goals           : dict[Agent, Position]
        + priorities      : dict[Agent, float]
        - _next           : dict[Agent, Position]
        - _processed      : set[Agent]
        - _grid           : Grid | None
        + _last_order     : list[Agent]
        + _last_moves     : dict[Agent, tuple]
        + _last_inheritance : list[tuple]
        --
        + plan(agents: list[Agent], grid: Grid) : dict[int, Position]
        - _init_priorities_if_needed(agents) : void
        - _h(pos: Position, agent: Agent) : int
        - _reserving_agent(pos: Position) : Agent | None
        - _pibt(agent: Agent, parent: Agent | None) : bool
    }
}

Renderer "1" o-- "1" Simulation : sim
Renderer ..> WorldEntity : reads
PIBTRenderer --|> Renderer : extends
PIBTRenderer "1" o-- "1" PIBT : pibt

PIBTInteractiveRenderer "1" o-- "1" Simulation : sim
PIBTInteractiveRenderer "1" o-- "1" PIBT       : pibt
PIBTInteractiveRenderer ..> StepSnapshot       : builds

RandomWalkCoordinator --|> Coordinator : implements
PIBT --|> Coordinator : implements
PIBT "1" o-- "0..*" Agent : priorities\ngoals

note bottom of Position
  Immutable (frozen dataclass).
  Supporte l'addition vectorielle
  pour le calcul de déplacement.
end note

note right of WorldEntity
  Base commune à toute entité de la grille.
  blocks_movement=True → case infranchissable.
  Pas besoin de sous-classe pour les obstacles :
  WorldEntity(id, pos, blocks_movement=True) suffit.
  appear_at : spawn différé (step).
end note

note right of Agent
  Hashable via agent_id (immuable).
  Utilisable comme clé de dict dans
  PIBT.priorities et PIBT.goals.
  Toujours blocks_movement=True.
  Pas de stratégie — le mouvement est
  entièrement délégué au Coordinator.
end note

note right of Grid
  is_blocked() unifie agents + entités statiques :
  Grid est la seule source de vérité
  sur la navigabilité d'une case.
end note

note right of Simulation
  Moteur pur, sans dépendance d'affichage.
  coordinator est obligatoire — step()
  délègue toujours coordinator.plan().
end note

note right of PIBT
  Algorithme pur — zéro dépendance pygame.
  Priority Inheritance + Backtracking
  (Okumura 2022).
  _last_* expose l'état interne pour
  PIBTRenderer sans coupler algo et client.
end note

@enduml
